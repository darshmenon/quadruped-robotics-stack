<?xml version="1.0"?>
<robot name="go2_description" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include base go2 URDF -->
  <xacro:include filename="$(find champ_description)/urdf/go2.urdf"/>

  <!-- 5-DOF manipulator arm mounted on top of the body, forward of center
       and above the base collision box (0.3762 x 0.0935 x 0.114, top face
       at z=0.057) so it doesn't intersect the body mesh -->
  <xacro:include filename="$(find champ_description)/urdf/arm.urdf.xacro"/>
  <xacro:champ_arm parent="base">
    <origin rpy="0 0 0" xyz="0.08 0 0.057"/>
  </xacro:champ_arm>

  <!-- Gazebo Harmonic gz_ros2_control plugin. training/ has no package.xml
       (it's plain Python run via `python3 script.py`, not a ROS2 package),
       so $(find training) can't resolve it: it previously fell through to
       whatever other overlaid workspace happened to have a colcon package
       literally named "training" and baked in that repo's install path.
       __REPO_ROOT__ is resolved dynamically (to this checkout's actual path)
       by scripts/make_go2_stand.py when it converts this file to SDF. -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>__REPO_ROOT__/training/config/go2_ros2_control.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- Publishes /world/<world>/model/<model>/joint_state (gz.msgs.Model)
       unconditionally every update, independent of ros2_control's
       controller_manager lifecycle. Launch files bridge this straight to
       ROS /joint_states, see launch/gazebo_go2.launch.py's bridge args. -->
  <gazebo>
    <plugin filename="libgz-sim-joint-state-publisher-system.so"
            name="gz::sim::systems::JointStatePublisher">
    </plugin>
  </gazebo>

  <!-- ros2_control hardware interface -->
  <ros2_control name="go2_gz" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="FL_hip_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.1</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="FL_thigh_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.8</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="FL_calf_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">-1.5</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="FR_hip_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">-0.1</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="FR_thigh_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.8</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="FR_calf_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">-1.5</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RL_hip_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.1</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RL_thigh_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">1.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RL_calf_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">-1.5</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RR_hip_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">-0.1</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RR_thigh_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">1.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RR_calf_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">-1.5</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="base_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="lower_arm_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="upper_arm_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist1_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist2_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <!-- Both fingers get independent command interfaces, see
         ros2/champ_description/urdf/arm.urdf.xacro's macro-level comment on
         why right_finger_joint's <mimic> isn't relied on here. -->
    <joint name="left_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- IMU sensor on base -->
  <gazebo reference="base">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <topic>/imu/data</topic>
      <gz_frame_id>base</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- LiDAR sensor on base -->
  <gazebo reference="base">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <gz_frame_id>base</gz_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.015</resolution>
        </range>
      </ray>
    </sensor>
  </gazebo>

  <!-- 3D LiDAR (16-channel, VLP-16-style) for RTAB-Map point-cloud SLAM.
       Mounted at z=0.15 (base origin), x=-0.05, rear of center so it
       clears the manipulator arm (mounted forward at x=0.08, see arm
       include above) and sits about 0.09m above the base collision box's
       top face (z=0.057), matching the 0.10m clearance rosnav's
       lidar3d.xacro found necessary to avoid the downward FOV cone
       self-hitting the chassis at close range. Publishes
       gz.msgs.PointCloudPacked on the nested "points/points" topic
       (gpu_lidar publishes LaserScan on its own topic and PointCloud2 on
       a nested "/points" subtopic); bridge accordingly. -->
  <gazebo reference="base">
    <sensor name="lidar3d" type="gpu_lidar">
      <pose>-0.05 0 0.15 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <topic>points</topic>
      <gz_frame_id>base</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>1800</samples>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <min_angle>-0.1745</min_angle>
            <max_angle>0.1745</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.3</min>
          <max>30.0</max>
          <resolution>0.001</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Forward-facing RGB camera for the RViz picture-in-picture inset (see
       ros2/champ_navigation/rviz/slam.rviz's Image display). Native gz-sim
       sensor, same style as the imu/lidar blocks above, no gazebo_ros
       plugin (that's classic Gazebo only); bridge via ros_gz_bridge in
       launch/slam3d_go2.launch.py instead. -->
  <gazebo reference="base">
    <sensor name="camera" type="camera">
      <pose>0.15 0 0.05 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>camera/image_raw</topic>
      <gz_frame_id>base</gz_frame_id>
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>30</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- Ground-projected frame for RTAB-Map (see slam3d_go2.launch.py's
       frame_id). "base" sits at nominal_height=0.22m (config/go2_champ/
       gait.yaml) above the ground, so using it directly as RTAB-Map's
       frame_id would put the map/grid's z=0 origin at body height instead
       of the ground, and the 2D occupancy grid then renders floating above
       where the feet actually are. base_footprint is fixed (not measured
       ride height) because SLAM needs a frame rigidly attached to the
       robot, same fix as Magi's magi_slam (ali-pahlevani/Magi). -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 -0.22" rpy="0 0 0"/>
  </joint>

</robot>
