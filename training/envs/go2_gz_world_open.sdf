<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="go2_rl">

    <physics name="1ms" type="ode">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Same ambient/no-shadow setup as go2_gz_world_outdoor.sdf: software/
         EGL Ogre2 fallback renders an unlit black scene with a shadow-
         casting sun and no ambient fill, which also starves the gpu_lidar. -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.75 0.78 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Open flat ground with visual-only pillars and lane marks (no walls) for walking recordings -->
    <model name="pillar_0"><static>true</static><pose>-4 -4.5 0.5 0 0 0</pose><link name="link"><visual name="v">
      <geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry>
      <material><ambient>0.85 0.25 0.2 1</ambient><diffuse>0.85 0.25 0.2 1</diffuse></material></visual></link></model>
    <model name="pillar_1"><static>true</static><pose>-4 4.5 0.5 0 0 0</pose><link name="link"><visual name="v">
      <geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry>
      <material><ambient>0.2 0.45 0.85 1</ambient><diffuse>0.2 0.45 0.85 1</diffuse></material></visual></link></model>
    <model name="pillar_2"><static>true</static><pose>0 -4.5 0.5 0 0 0</pose><link name="link"><visual name="v">
