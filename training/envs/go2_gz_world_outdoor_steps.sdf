<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="go2_rl">

    <physics name="1ms" type="ode">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Same ambient/no-shadow setup as go2_gz_world_outdoor.sdf: software/
         EGL Ogre2 fallback renders an unlit black scene with a shadow-
         casting sun and no ambient fill, which also starves the gpu_lidar. -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.62 0.78 0.92 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.36 0.58 0.28 1</ambient><diffuse>0.36 0.58 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Outdoor props from go2_gz_world_outdoor.sdf (local Fuel cache) and a low-step flight -->
    <include><name>pine_tree_1</name><uri>file:///home/asimov/.gz/fuel/fuel.gazebosim.org/openrobotics/models/pine%20tree/6</uri><static>true</static><pose>6 3 0 0 0 0.3</pose></include>
    <include><name>pine_tree_2</name><uri>file:///home/asimov/.gz/fuel/fuel.gazebosim.org/openrobotics/models/pine%20tree/6</uri><static>true</static><pose>-5 6 0 0 0 1.1</pose></include>
    <include><name>pine_tree_3</name><uri>file:///home/asimov/.gz/fuel/fuel.gazebosim.org/openrobotics/models/pine%20tree/6</uri><static>true</static><pose>-7 -4 0 0 0 2.4</pose></include>
    <include><name>oak_tree_1</name><uri>file:///home/asimov/.gz/fuel/fuel.gazebosim.org/openrobotics/models/oak%20tree/7</uri><static>true</static><pose>5 -6 0 0 0 0.8</pose></include>
    <include><name>oak_tree_2</name><uri>file:///home/asimov/.gz/fuel/fuel.gazebosim.org/openrobotics/models/oak%20tree/7</uri><static>true</static><pose>-3 8 0 0 0 2.0</pose></include>
    <model name="step_1"><static>true</static><pose>2.150 0.000 0.0150 0 0 0.000</pose><link name="l"><collision name="c"><geometry><box><size>0.3 6.0 0.03</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision><visual name="v"><geometry><box><size>0.3 6.0 0.03</size></box></geometry><material><ambient>0.8 0.78 0.72 1</ambient><diffuse>0.8 0.78 0.72 1</diffuse></material></visual></link></model>
    <model name="edge_1"><static>true</static><pose>2.020 0.000 0.0310 0 0 0.000</pose><link name="l"><visual name="v"><geometry><box><size>0.04 6.0 0.004</size></box></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual></link></model>
    <model name="step_2"><static>true</static><pose>2.450 0.000 0.0300 0 0 0.000</pose><link name="l"><collision name="c"><geometry><box><size>0.3 6.0 0.06</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision><visual name="v"><geometry><box><size>0.3 6.0 0.06</size></box></geometry><material><ambient>0.8 0.78 0.72 1</ambient><diffuse>0.8 0.78 0.72 1</diffuse></material></visual></link></model>
    <model name="edge_2"><static>true</static><pose>2.320 0.000 0.0610 0 0 0.000</pose><link name="l"><visual name="v"><geometry><box><size>0.04 6.0 0.004</size></box></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual></link></model>
    <model name="step_3"><static>true</static><pose>2.750 0.000 0.0450 0 0 0.000</pose><link name="l"><collision name="c"><geometry><box><size>0.3 6.0 0.09</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision><visual name="v"><geometry><box><size>0.3 6.0 0.09</size></box></geometry><material><ambient>0.8 0.78 0.72 1</ambient><diffuse>0.8 0.78 0.72 1</diffuse></material></visual></link></model>
    <model name="edge_3"><static>true</static><pose>2.620 0.000 0.0910 0 0 0.000</pose><link name="l"><visual name="v"><geometry><box><size>0.04 6.0 0.004</size></box></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual></link></model>
    <model name="step_4"><static>true</static><pose>3.050 0.000 0.0600 0 0 0.000</pose><link name="l"><collision name="c"><geometry><box><size>0.3 6.0 0.12</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision><visual name="v"><geometry><box><size>0.3 6.0 0.12</size></box></geometry><material><ambient>0.8 0.78 0.72 1</ambient><diffuse>0.8 0.78 0.72 1</diffuse></material></visual></link></model>
    <model name="edge_4"><static>true</static><pose>2.920 0.000 0.1210 0 0 0.000</pose><link name="l"><visual name="v"><geometry><box><size>0.04 6.0 0.004</size></box></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual></link></model>
    <model name="landing"><static>true</static><pose>6.200 0.000 0.0600 0 0 0.000</pose><link name="l"><collision name="c"><geometry><box><size>6.0 6.0 0.12</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision><visual name="v"><geometry><box><size>6.0 6.0 0.12</size></box></geometry><material><ambient>0.74 0.72 0.68 1</ambient><diffuse>0.74 0.72 0.68 1</diffuse></material></visual></link></model>
    <!-- Follow camera: moved with the set_pose service by scripts/record_go2_rl_gz.py; off unless subscribed -->
    <model name="showcase_cam">
      <static>false</static>
      <pose>-2 -3 1.5 0 0.3 1.0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial><mass>0.1</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
        <sensor name="showcase_cam" type="camera">
          <always_on>0</always_on>
          <update_rate>15</update_rate>
          <topic>showcase_cam/image</topic>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>800</width><height>450</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>40</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
</world>
</sdf>
