<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="go2_rl">

    <physics name="1ms" type="ode">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Same ambient/no-shadow setup as go2_gz_world_outdoor.sdf: software/
         EGL Ogre2 fallback renders an unlit black scene with a shadow-
         casting sun and no ambient fill, which also starves the gpu_lidar. -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.75 0.78 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Enclosed two-room "house" (10m x 8m outer envelope) for bounded indoor
         SLAM/frontier-exploration testing -- the other worlds in this repo
         are all open outdoor terrain, which never gives RTAB-Map/frontier
         exploration a closed loop to finish mapping. A dividing wall along
         x=0 with a 2.4m doorway gap at y=[-1.2, 1.2] (where the robot spawns)
         splits the envelope into west/east halves and forces the explorer
         through a passage instead of just circling one open room.
         Each wall is its own static model (same pattern as outdoor trees/
         rocks) so Gazebo doesn't need intra-model fixed joints. -->

    <model name="wall_north">
      <static>true</static>
      <pose>0 4 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 2</size></box></geometry>
          <material><ambient>0.7 0.65 0.6 1</ambient><diffuse>0.7 0.65 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -4 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 2</size></box></geometry>
          <material><ambient>0.7 0.65 0.6 1</ambient><diffuse>0.7 0.65 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>5 0 1 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 0.2 2</size></box></geometry>
          <material><ambient>0.7 0.65 0.6 1</ambient><diffuse>0.7 0.65 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 1 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 0.2 2</size></box></geometry>
          <material><ambient>0.7 0.65 0.6 1</ambient><diffuse>0.7 0.65 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_divider_a">
      <static>true</static>
      <pose>0 -2.6 1 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.8 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.8 0.2 2</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_divider_b">
      <static>true</static>
      <pose>0 2.6 1 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.8 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.8 0.2 2</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

  
    <!-- Showcase camera for README GIFs: off unless something subscribes to /showcase_cam/image -->
    <model name="showcase_cam">
      <static>true</static>
      <pose>4.5 -3.5 4.0 0 0.61 2.48</pose>
      <link name="link">
        <sensor name="showcase_cam" type="camera">
          <always_on>0</always_on>
          <update_rate>15</update_rate>
          <topic>showcase_cam/image</topic>
          <camera>
            <horizontal_fov>1.4</horizontal_fov>
            <image><width>960</width><height>540</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>15</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
</world>
</sdf>
